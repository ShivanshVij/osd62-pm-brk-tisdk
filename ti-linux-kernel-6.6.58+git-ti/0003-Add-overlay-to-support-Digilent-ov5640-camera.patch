From e5b7d8b0ede6a3699c623784d475ca4fcad10f55 Mon Sep 17 00:00:00 2001
From: Neeraj Dantu <dantuguf14105@gmail.com>
Date: Fri, 1 Aug 2025 15:51:27 -0400
Subject: [PATCH 3/5] Add overlay to support Digilent ov5640 camera for
 OSD625-PM-BRK

---
 arch/arm64/boot/dts/ti/Makefile               |   1 +
 .../ti/k3-am625-osd625-brk-csi2-ov5640.dtso   | 101 ++++++++++++++++++
 2 files changed, 102 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am625-osd625-brk-csi2-ov5640.dtso

diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
index dc6595aa4..92473e74d 100644
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -37,6 +37,7 @@ dtb-$(CONFIG_ARCH_K3) += k3-am625-sk-mcspi-loopback.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62-lp-sk-nand.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am625-osd625-brk.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am625-osd625-brk-microtips-mf101hie-panel.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am625-osd625-brk-csi2-ov5640.dtbo
 
 # Boards with AM62Ax SoC
 k3-am62a7-sk-ub954-evm-ov2312-dtbs := k3-am62a7-sk.dtb \
diff --git a/arch/arm64/boot/dts/ti/k3-am625-osd625-brk-csi2-ov5640.dtso b/arch/arm64/boot/dts/ti/k3-am625-osd625-brk-csi2-ov5640.dtso
new file mode 100644
index 000000000..f9da3c34d
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am625-osd625-brk-csi2-ov5640.dtso
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * ALINX AN5641 & Digilent PCam 5C - OV5640 camera module
+ *
+ * Copyright (C) 2025 Octavo Systems LLC - https://www.octavosystems.com/
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "k3-pinctrl.h"
+
+&{/} {
+	clk_ov5640_fixed: ov5640-xclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <12000000>;
+	};
+};
+&main_pmx0 {
+	camera_gpio_pins_default: camera_gpio_pins_default {
+		pinctrl-single,pins = <
+			AM62X_IOPAD(0x0254, PIN_OUTPUT, 7) /* (B18) USB0_DRVVBUS.GPIO1_50 */
+		>;
+	};
+};
+
+&main_gpio1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&camera_gpio_pins_default>;
+	p11-hog {
+		/* P11 - CSI2_CAMERA_GPIO1 */
+		gpio-hog;
+		gpios = <50 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "CSI2_CAMERA_EN";
+	};
+};
+
+&mcu_pmx0 {
+	i2c_csi_pins_default: i2c-csi-pins-default {
+		pinctrl-single,pins = <
+			AM62X_MCU_IOPAD(0x004c, PIN_INPUT_PULLUP, 0) /* (B9) WKUP_I2C0_SCL */
+			AM62X_MCU_IOPAD(0x0050, PIN_INPUT_PULLUP, 0) /* (A9) WKUP_I2C0_SDA */
+		>;
+	};
+
+};
+
+/* CAM port */
+&wkup_i2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c_csi_pins_default>;
+	status = "okay";
+
+	ov5640: camera@3c {
+		compatible = "ovti,ov5640";
+		reg = <0x3c>;
+
+		clocks = <&clk_ov5640_fixed>;
+		clock-names = "xclk";
+
+		port {
+			csi2_cam0: endpoint {
+				remote-endpoint = <&csi2rx0_in_sensor>;
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
+&cdns_csi2rx0 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		csi0_port0: port@0 {
+			reg = <0>;
+			status = "okay";
+
+			csi2rx0_in_sensor: endpoint {
+				remote-endpoint = <&csi2_cam0>;
+				bus-type = <4>; /* CSI2 DPHY. */
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
+&ti_csi2rx0 {
+	status = "okay";
+};
+
+&dphy0 {
+	status = "okay";
+};
-- 
